{#
    渲染 Markdown 内容模板

    - inline_css: 内联自定义样式
    - content: 预渲染的 HTML 内容（由 Python 端 Markdown 库转换）
#}

<!DOCTYPE html>
<html>
<head>
    <title>Markdown 文档</title>
    <style> {{ inline_css | safe }} </style>
</head>
<body>
    <div id="preview">
        {{ content | safe }}
    </div>
</body>
</html>