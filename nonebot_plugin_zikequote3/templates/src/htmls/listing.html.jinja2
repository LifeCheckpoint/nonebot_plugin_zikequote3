{# 
    语录列表模板
    
    - inline_css: 内联CSS样式
    
    - title: 列表标题
    - description: 语录信息描述
    - addition: 附加信息
    - sections: 分页语录列表
        - title: 分页标题
        - color: 分页颜色
        - boxes: 该页语录列表
            - quote: 语录内容
            - comment: 语录首条评论
            - comment_author_name: 语录首条评论作者
#}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <style>
        {{ inline_css | safe }}
    </style>
</head>
<body>
    <div class="page-container">
        <header class="page-header">
            <h1>{{ title }}</h1>
            <span class="version">{{ description }}</span>
            <p class="description">{{ addition }}</p>
        </header>

        <main class="main-content">
            {% for section in sections %}
            <section class="section">
                <h2 class="section-title" style="background: {{ section.color }};">{{ section.title }}</h2>
                <div class="quotes-grid">
                    {% for box in section.boxes %}
                    {% set random_theme = ['theme-purple', 'theme-blue', 'theme-green', 'theme-pink', 'theme-orange', 'theme-teal', 'theme-indigo'] | random %}
                    <div class="quote-item {{ random_theme }}" style="border-left-color: var(--accent-color);">
                        <div class="quote-text">{{ box.quote }}</div>
                        
                        {% if box.comment %}
                        <div class="quote-comment">
                            {{ box.comment }}
                        </div>
                        {% endif %}
                        
                        {% if box.comment_author_name and box.comment %}
                        <div class="comment-author">
                            <span class="comment-author-tag">{{ box.comment_author_name }}</span>
                        </div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            </section>
            {% endfor %}
        </main>

        <footer class="page-footer">
            <p>@ZikeQuote3 by LifeCheckpoint</p>
        </footer>
    </div>
</body>
</html>